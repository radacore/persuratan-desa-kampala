# Konfigurasi SILADESA — salin menjadi .env lalu sesuaikan.
# JANGAN commit berkas .env yang berisi nilai sebenarnya.

APP_ENV=development
APP_VERSION=1.0.0
APP_URL=http://localhost:8000

# Wajib diganti di produksi: openssl rand -hex 32
SECRET_KEY=ganti-dengan-32-byte-hex-acak-di-produksi

# Kosongkan untuk memakai SQLite lokal (data/siladesa.db)
DATABASE_URL=

# Akun admin pertama, dibuat oleh `python -m app.seed`
BOOTSTRAP_ADMIN_EMAIL=admin@desakampala.id
BOOTSTRAP_ADMIN_PASSWORD=Admin#2026
# Akun contoh operator/sekdes/kepala desa; hanya dibuat bila APP_ENV bukan production.
BOOTSTRAP_DEMO_PASSWORD=Demo#2026

# Kanal
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FONNTE_TOKEN=
FONNTE_WEBHOOK_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send

# NLP
CONFIDENCE_TINGGI=0.65
CONFIDENCE_RENDAH=0.40

# Berkas
STORAGE_DIR=data/storage
MODEL_DIR=data/models
MAX_UPLOAD_MB=5
DOWNLOAD_TOKEN_TTL_DAYS=7

# Batas laju per IP (login 10/menit, chat 120/menit, verifikasi 60/menit).
# Matikan hanya untuk pengujian: seluruh kasus uji datang dari satu IP.
RATE_LIMIT_ENABLED=true

LOG_LEVEL=INFO
